5 ' Ichigo Eater Color V.0.5
10 CLS:POKE #700,#3C,#7E,#DB,#FF,#24,#5A,#A5,#42,#3C,#7E,#DB,#FF,#42,#A5,#5A,#24
15 POKE #710,#18,#3C,#7E,#DB,#FF,#24,#66,#C3,#18,#3C,#7E,#DB,#FF,#42,#66,#81
20 LET[0],#FF,#FF,#FF,#80,#18,#01,#BD,#DB,#BD,#80,#00,#01,#BD,#7E,#BD,#81,#0C,#81,#FD,#ED
30 LET[20],#EF,#80,#18,#01,#BD,#C3,#BD,#81,#00,#81,#BD,#7E,#BD,#80,#18,#01,#FD,#ED,#EF,#81
40 LET[40],#0C,#81,#BD,#7E,#BD,#80,#00,#01,#BD,#DB,#BD,#80,#18,#01,#FF,#FF,#FF
50 COLOR 5,1,1:LC 0,0:?"ICHIGO EATER COLOR";
60 COLOR 15,1,1:LC 19,0:?"SCORE:";0
70 O=4:V=2:D=0:S=0:T=0
80 FOR J=0 TO 18
90 FOR I=0 TO 2
100 B=[I+J*3]
110 FOR K=0 TO 7
120 LC O+K+I*8,V+J
130 IF B&#80 THEN COLOR 5,1,1:?CHR$(1); ELSE COLOR 15,1,1:?CHR$(255);:D=D+1
140 B=(B<<1)&#FF
150 NEXT:NEXT:NEXT
160 X=O+1:Y=V+1:M=O+22:N=V+17:P=O+1:Q=V+17:G=SCR(M,N):H=SCR(P,Q)
170 LC X,Y:COLOR 10,1,1:?CHR$(249);:D=D-1
180 COLOR 3,1,1:LC M,N:?CHR$(#E0+(T&#1));
190 COLOR 13,1,1:LC P,Q:?CHR$(#E2+(T&#1));
200 K=INKEY():CLK
210 A=X-(K=28)+(K=29)
220 B=Y-(K=30)+(K=31)
230 C=SCR(A,B)
240 IF C=255 THEN D=D-1:S=S+10:BEEP 30,1
250 IF C<>1 THEN LC X,Y:COLOR 1,1,1:?" ";:X=A:Y=B
260 IF X=M AND Y=N THEN GOTO 700
270 IF X=P AND Y=Q THEN GOTO 700
280 COLOR 10,1,1:LC X,Y:?CHR$(249+(X+Y)&#1);
290 COLOR 15,1,1:LC 25,0:?S;"    "
300 IF D=0 THEN GOTO 800
310 T=T+1:IF T%3<>0 THEN GOTO 600
320 LC M,N
330 IF G=255 THEN COLOR 15,1,1:?CHR$(255);
340 IF G<>255 THEN COLOR 1,1,1:?" ";
350 E=M+(X>M)-(X<M)
360 F=N+(Y>N)-(Y<N)
370 IF SCR(E,N)<>1 THEN M=E
380 IF SCR(M,F)<>1 THEN N=F
390 IF X=M AND Y=N THEN GOTO 700
400 G=SCR(M,N)
410 COLOR 3,1,1:LC M,N:?CHR$(#E0+(T&#1));
420 LC P,Q
430 IF H=255 THEN COLOR 15,1,1:?CHR$(255);
440 IF H<>255 THEN COLOR 1,1,1:?" ";
450 E=P+(X>P)-(X<P)
460 F=Q+(Y>Q)-(Y<Q)
470 IF SCR(P,F)<>1 THEN Q=F
480 IF SCR(E,Q)<>1 THEN P=E
490 IF X=P AND Y=Q THEN GOTO 700
500 H=SCR(P,Q)
510 COLOR 13,1,1:LC P,Q:?CHR$(#E2+(T&#1));
600 COLOR 3,1,1:LC M,N:?CHR$(#E0+(T&#1));
610 COLOR 13,1,1:LC P,Q:?CHR$(#E2+(T&#1));
620 WAIT 5
630 GOTO 200
700 COLOR 15,8,1
710 LC 9,22:?" GAME OVER "
720 BEEP 10,30
730 COLOR 15,1,1:?"CONTINU";:INPUT A
740 RUN
800 COLOR 10,1,1
810 LC 12,22:?"CLEAR!"
820 BEEP 60,10:BEEP 80,10:BEEP 100,20
830 COLOR 15,1,1:?"CONTINU";:INPUT A
840 RUN
